#include <Servo.h>

Servo servo1;
Servo servo2;
Servo servo3;

const int buttonPin = 2;      
const unsigned long runTime = 65000; //millsecond

int angle = 0;          // current angle
int increment = 1;      // step

bool isRunning = false;
unsigned long startTime = 0;

void setup() {
  servo1.attach(9);
  servo2.attach(10);
  servo3.attach(11);
  pinMode(buttonPin, INPUT_PULLUP);

  servo1.write(0);
  servo2.write(0);
  servo3.write(0);
  delay(1000);
}

void loop() {
  if (digitalRead(buttonPin) == LOW && !isRunning) {
    isRunning = true;
    startTime = millis(); 
  }

  if (isRunning) {
   
    if (millis() - startTime >= runTime) {
      isRunning = false;
      // servo1.write(0);
      // servo2.write(0);
      // servo3.write(0);
      // angle = 0;
      return;
    }

    servo1.write(angle);  
    // delay(delayOffset);
    servo2.write(angle);
    servo3.write(angle);
    delay(55);    

    angle += increment;    // update agnle

    // move opposite side when 0 or 90 degree
    if (angle <= 0 || angle >= 110) {
      increment = -increment;
    }
  }
}

#include <Wire.h>
#include <WiFi.h>
#include <WiFiUdp.h>

const int MPU_ADDR = 0x68;
const char *ssid = "BreathNet";
const char *password = "12345678";

WiFiUDP udp;
const char *udpAddress = "192.168.4.255";
const int udpPort = 4210;

// Button configuration
const int buttonPin = 2;
bool systemActive = false;

// IMU & Smoothing Variables
float basePitch = 0.0, baseRoll = 0.0;
float filteredVal = 0.0;
int countVal = 0;
float readingsArray[15][3] = {0};

// Pace Tracking Variables
unsigned long lastBreathTime = 0;
unsigned long breathPeriods[5] = {0};
int breathIndex = 0;
int totalBreathsCaught = 0;
float avgPeriodMs = 0.0;
bool isExhaling = true;

// --- 4-7-8 ENTRAINMENT VARIABLES ---
float currentPhase = 0.0;
float guidedPeriodMs = 0.0;
unsigned long lastLoopTime = 0;
unsigned long mirrorStartTime = 0;
bool isMirroring = false;

void setup() {
  Serial.begin(115200);
  delay(1000);
  Wire.begin(21, 22);
  
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B);
  Wire.write(0x00);
  Wire.endTransmission();
  
  // MUST tell the ESP32 to treat the button pin as an input
  pinMode(buttonPin, INPUT_PULLUP);
  
  WiFi.softAP(ssid, password);
  Serial.println("AP Created: BreathNet");
  udp.begin(udpPort);
  
  lastLoopTime = millis();
}

void loop() {
  unsigned long nowTime = millis();
  unsigned long dt = nowTime - lastLoopTime;
  lastLoopTime = nowTime;

  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);
  Wire.endTransmission(false);
  Wire.requestFrom((uint8_t)MPU_ADDR, (size_t)6, true);

  if (Wire.available() >= 6) {
    int16_t rawX = (Wire.read() << 8) | Wire.read();
    int16_t rawY = (Wire.read() << 8) | Wire.read();
    int16_t rawZ = (Wire.read() << 8) | Wire.read();

    float ax = (float)rawX / 16384.0;
    float ay = (float)rawY / 16384.0;
    float az = (float)rawZ / 16384.0;

    // 15-point Circular Buffer
    readingsArray[countVal][0] = ax;
    readingsArray[countVal][1] = ay;
    readingsArray[countVal][2] = az;  

    countVal++;
    if(countVal == 15){ countVal = 0; }
    
    float avgX = 0.0, avgY = 0.0, avgZ = 0.0;
    for(int i = 0; i < 15; ++i){
      avgX += readingsArray[i][0];
      avgY += readingsArray[i][1];
      avgZ += readingsArray[i][2];
    }
    float finalAx = avgX/15.0;
    float finalAy = avgY/15.0;
    float finalAz = avgZ/15.0;

    // Posture filtering
    float pitch = atan2(-finalAx, sqrt(finalAy * finalAy + finalAz * finalAz)) * (180.0 / M_PI);
    float roll  = atan2(finalAy, finalAz) * (180.0 / M_PI);

    if (basePitch == 0.0) { basePitch = pitch; baseRoll = roll; }
    basePitch = (0.01 * pitch) + (0.99 * basePitch);
    baseRoll  = (0.01 * roll)  + (0.99 * baseRoll);

    float dPitch = pitch - basePitch;
    
    // FIX 1: Locked to pitch to prevent axis-swapping twitches
    float currentDev = dPitch; 

    filteredVal = (0.05 * currentDev) + (0.95 * filteredVal);
    
    // FIX 2: Scaled to 10.0 to prevent clipping on deep breaths
    float respSignal = filteredVal * 5.0; 
    
    // Default output when system is inactive
    float outputSignal = 7.5; 

    // --- BUTTON START LOGIC ---
    if (!systemActive) {
      if (digitalRead(buttonPin) == LOW) {
        systemActive = true;
        Serial.println("\n✅ System Activated! Start breathing.");
        delay(500); // Debounce
        
        // Reset breath timers so it starts fresh
        lastBreathTime = millis();
      }
    } 
    else {
      // --- ZERO-CROSSING PACE DETECTOR ---
      if (isExhaling && respSignal > 1.0) {
        unsigned long currentPeriod = nowTime - lastBreathTime;

        // FIX 3: Opened window to 25 seconds for slow, deep breaths
        if (currentPeriod > 1500 && currentPeriod < 25000) {
          breathPeriods[breathIndex] = currentPeriod;
          breathIndex = (breathIndex + 1) % 5;

          if (totalBreathsCaught < 5) {
            totalBreathsCaught++;
          }
          
          unsigned long sum = 0;
          for (int i = 0; i < totalBreathsCaught; i++) {
            sum += breathPeriods[i];
          }
          avgPeriodMs = (float)sum / totalBreathsCaught;
        }
        lastBreathTime = nowTime;
        isExhaling = false;
      }
      else if (!isExhaling && respSignal < -1.0) {
        isExhaling = true;
      }

      // --- 4-PHASE MORPHING SIGNAL GENERATION ---
      if (totalBreathsCaught < 5) {
        // PHASE 1: Learning Mode
        outputSignal = (respSignal / 2.0) + 7.5;
        outputSignal = constrain(outputSignal, 0.0, 15.0);
        guidedPeriodMs = avgPeriodMs;
      }
      else {
        if (!isMirroring) {
          isMirroring = true;
          mirrorStartTime = nowTime;
        }

        float blend = 0.0; 

        if (nowTime - mirrorStartTime < 60000) {
          // PHASE 2: Mirror Mode (0 to 60 seconds)
          guidedPeriodMs = avgPeriodMs;
          blend = 0.0;
        } 
        else if (nowTime - mirrorStartTime < 80000) {
          // PHASE 3: Transition Mode (60s to 80s)
          float progress = (float)(nowTime - mirrorStartTime - 60000) / 20000.0;
          guidedPeriodMs = avgPeriodMs + ((19000.0 - avgPeriodMs) * progress);
          blend = progress; 
        } 
        else {
          // PHASE 4: Final 4-7-8 State (80s onward)
          guidedPeriodMs = 19000.0; 
          blend = 1.0;
        }
        
        currentPhase += (float)dt / guidedPeriodMs;
        if (currentPhase >= 1.0) { currentPhase -= 1.0; }

        // Shape 1: Standard Symmetric Sine Wave
        float waveSine = (-cos(currentPhase * 2.0 * M_PI) + 1.0) * 7.5;
        
        // Shape 2: The Biological 4-7-8 Wave (Quarter-Sine avoids dead zones)
        float wave478 = 0.0;
        if (currentPhase <= (4.0 / 19.0)) {
          // INHALE
          float inhalePhase = currentPhase / (4.0 / 19.0);
          wave478 = sin(inhalePhase * (M_PI / 2.0)) * 15.0;
        } 
        else if (currentPhase <= (11.0 / 19.0)) {
          // HOLD
          wave478 = 15.0; 
        } 
        else {
          // EXHALE
          float exhalePhase = (currentPhase - (11.0 / 19.0)) / (8.0 / 19.0);
          wave478 = cos(exhalePhase * (M_PI / 2.0)) * 15.0; 
        }

        // Cross-fade the shapes
        outputSignal = (waveSine * (1.0 - blend)) + (wave478 * blend);
      }
    }

    udp.beginPacket(udpAddress, udpPort);
    udp.print(outputSignal);
    udp.endPacket();
  }
  delay(20);
}

#include <WiFiS3.h>
#include <WiFiUdp.h>
#include <Servo.h>

const char *ssid = "BreathNet";
const char *password = "12345678";

WiFiUDP udp;
unsigned int localPort = 4210;
char packetBuffer[255];

Servo myServo1;
Servo myServo2;
Servo myServo3;

const int SERVO_PIN_1 = 9; 
const int SERVO_PIN_2 = 10;
const int SERVO_PIN_3 = 11;

// Base target signal
float targetMicroseconds = 544.0; // 1500us is center (90 degrees)

// Individual smoothed states
float smoothedUS1 = 544.0;
float smoothedUS2 = 544.0;
float smoothedUS3 = 544.0;

// NEW: Independent timer
unsigned long lastServoUpdate = 0;

// Custom float mapping function to prevent integer truncation
float mapFloat(float x, float in_min, float in_max, float out_min, float out_max) {
  return (x - in_min) * (out_max - out_min) / (in_max - in_min) + out_min;
}

void setup() {
  Serial.begin(115200);
  
  myServo1.attach(SERVO_PIN_1);
  myServo2.attach(SERVO_PIN_2);
  myServo3.attach(SERVO_PIN_3);

  // Center servos on startup
  myServo1.writeMicroseconds(1500);
  myServo2.writeMicroseconds(1500);
  myServo3.writeMicroseconds(1500);

  Serial.print("Connecting to BreathNet AP...");
  while (WiFi.begin(ssid, password) != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi Connected!");

  udp.begin(localPort);
}

void loop() {
  int packetSize = udp.parsePacket();
  if (packetSize) {
    int len = udp.read(packetBuffer, 255);
    if (len > 0) {
      packetBuffer[len] = 0;
    }
    float respSignal = atof(packetBuffer);

    // Map respiration (0 to 15.0) to microseconds (1500 to 2500, which is 90 to 180 degrees)
    targetMicroseconds = mapFloat(respSignal, 0.0, 15.0, 544.0, 1678.0);
    
    // Constrain to safe servo limits
    targetMicroseconds = constrain(targetMicroseconds, 544.0, 1678.0);
  }

  // Adjust these multipliers. 
  // 1.0 = instant reaction (no delay). 
  // 0.05 = heavy, sluggish movement (more delay).
  
  smoothedUS1 = (0.60 * targetMicroseconds) + (0.40 * smoothedUS1); // Fast
  smoothedUS2 = (0.60 * targetMicroseconds) + (0.40 * smoothedUS2); // Medium
  smoothedUS3 = (0.60 * targetMicroseconds) + (0.40 * smoothedUS3); // Slow/Heavy

  // Write high-resolution signals to servos
  myServo1.writeMicroseconds((int)smoothedUS1);
  myServo2.writeMicroseconds((int)smoothedUS2);
  myServo3.writeMicroseconds((int)smoothedUS3);

  delay(20);
}

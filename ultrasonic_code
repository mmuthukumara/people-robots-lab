#include <Servo.h>

Servo servo1;
Servo servo2;
Servo servo3;

// Pin definitions
const int buttonPin = 2;  
const int trigPin = 12;
const int echoPin = 13;

// Ultrasonic sensor variables
long duration;
float distance_cm;

const unsigned long runTime = 300000; // 5 minutes (milliseconds)
int angle = 0;          // current angle
int increment = 1;      // step

bool isRunning = false;
unsigned long startTime = 0;

void setup() {
  Serial.begin(9600); // Useful for debugging the sensor distances

  servo1.attach(9);
  servo2.attach(10);
  servo3.attach(11);
  
  pinMode(buttonPin, INPUT_PULLUP);
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);

  // Initialize servos to 0
  servo1.write(0);
  servo2.write(0);
  servo3.write(0);
  delay(1000);
}

// Function to calculate distance from the HC-SR04 sensor
float getDistance() {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  
  duration = pulseIn(echoPin, HIGH);
  return duration * 0.0343 / 2;
}

void loop() {
  // 1. Read the distance from the sensor continuously
  distance_cm = getDistance();

  // 2. Trigger the sequence if the button is pressed OR an object is within 40cm
  if ((digitalRead(buttonPin) == LOW || (distance_cm > 0 && distance_cm <= 40)) && !isRunning) {
    isRunning = true;
    startTime = millis();
    delay(200); // Debounce
  }

  // If not running, do nothing else
  if(!isRunning) return; 

  // 3. Main Running Logic
  if (isRunning) {
    // Check if the total 5-minute run time has elapsed
    if (millis() - startTime >= runTime) {
      isRunning = false;
      servo1.write(0);
      servo2.write(0);
      servo3.write(0);
      return;
    }

    // 4. Determine and play pattern based on distance
    if (distance_cm > 0 && distance_cm <= 10) {
      playWavePattern();      // Really close
    } 
    else if (distance_cm > 10 && distance_cm <= 20) {
      playDelayPattern();     // A little close
    } 
    else if (distance_cm > 20 && distance_cm <= 30) {
      playSecondPattern();    // Not that close
    } 
    else {
      playFirstPattern();     // Far (> 30cm)
    }
    
    // 5. Wait a moment, then update the angle
    delay(55);    
    angle += increment;    

    // Reverse direction when hitting limits
    if (angle <= 0 || angle >= 110) {
      increment = -increment;
    }
  }
}

// ---------------------------------------------------------
// PATTERN FUNCTIONS
// ---------------------------------------------------------

void playFirstPattern() {
  // All move together
  servo1.write(angle);
  servo2.write(angle);
  servo3.write(angle);
}

void playSecondPattern() {
  // Only servo 1 moves
  servo1.write(angle);
  servo2.write(0);
  servo3.write(0);
}

void playDelayPattern() {
  // Staggered movement
  servo1.write(angle);
  servo2.write(max(0, angle - 30));
  servo3.write(max(0, angle - 50));
}

void playWavePattern() {
  // Tighter staggered movement
  servo1.write(angle);
  servo2.write(max(0, angle - 15));
  servo3.write(max(0, angle - 30));
}

// Keeping this here just in case you want to swap it back in later!
void playAlternatePattern() {
  servo1.write(0);
  servo2.write(angle);
  servo3.write(angle);
}

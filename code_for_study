#include <Servo.h>

Servo servo1;
Servo servo2;
Servo servo3;

const int buttonPin = 2;  
const int trigPin = 12;
const int echoPin = 13;

// 2 minutes in ms
const unsigned long runTime = 120000; 

// state
char currentMode = ' '; // starting at idle

// mode a -> off
bool isRunningO = false;
unsigned long startTimeO = 0;

// mode b -> random motor speeds
bool isRunningB = false;
unsigned long startTimeB = 0;
int target1 = 0, target2 = 0, target3 = 0;
int current1 = 0, current2 = 0, current3 = 0; // Tracks where servos actually are
unsigned long lastStepTime = 0;
const int stepDelay = 15; // Speed control, lower is faster, higher is slower
unsigned long lastRandomUpdate = 0;
unsigned long randomDelay = 0;

// mode c -> amy's original code
int angleC = 0;
int incrementC = 1;
bool isRunningC = false;
unsigned long startTimeC = 0;

// mode d -> code for co-design
int angleD = 0;
int incrementD = 1;
bool isRunningD = false;
unsigned long startTimeD = 0;
long duration;
float distance_cm;

void setup() {
  Serial.begin(9600); 

  servo1.attach(9);
  servo2.attach(10);
  servo3.attach(11);
  
  pinMode(buttonPin, INPUT_PULLUP);
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);

  resetServos();
  delay(1000);

  
  Serial.println("System Ready. Select a behavior:");
  Serial.println(" [o] -> Off Mode ");
  Serial.println(" [b] -> Randomized Motors");
  Serial.println(" [c] -> Amy's Original Code");
  Serial.println(" [d] -> Co-Design");
}


float getDistance() {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  
  duration = pulseIn(echoPin, HIGH);
  return duration * 0.0343 / 2;
}


void resetServos() {
  servo1.write(0);
  servo2.write(0);
  servo3.write(0);
}

void loop() {
  // Checking for user input, and updating states
  if (Serial.available() > 0) {
    char incoming = Serial.read();
    
    if (incoming == 'o' || incoming == 'b' || incoming == 'c' || incoming == 'd') {
      currentMode = incoming;
      Serial.print("Switched to mode: ");
      Serial.println(currentMode);
      
      // Reset running states and angles for a clean start
      isRunningO = false;
      isRunningB = false;
      isRunningC = false;
      isRunningD = false;
      angleC = 0;
      angleD = 0;
      
      // Sync smooth tracking positions to 0 since resetServos goes to 0
      current1 = 0; current2 = 0; current3 = 0;
      target1 = 0;  target2 = 0;  target3 = 0;
      resetServos();

      // Modes O and B start their timers immediately upon selection
      if (currentMode == 'o') {
        isRunningO = true;
        startTimeO = millis();
        Serial.println("Off Mode started. Resting for 2 minutes.");
      }
      else if (currentMode == 'b') {
        isRunningB = true;
        startTimeB = millis();
        lastRandomUpdate = millis();
        randomDelay = 0; // Trigger a random generation instantly on start
      }
    }
  }

  // 2. Execute the currently selected mode
  switch (currentMode) {
    case 'o':
      runModeO();
      break;
    case 'b':
      runModeB();
      break;
    case 'c':
      runModeC();
      break;
    case 'd':
      runModeD();
      break;
  }
}

// mode o -> off mode
void runModeO() {
  if (!isRunningO) return;

  // Check if 2 minutes have passed
  if (millis() - startTimeO >= runTime) {
    isRunningO = false;
    currentMode = ' '; // Return to idle state
    Serial.println("Off Mode complete. Waiting for new command.");
    return;
  }
}

// mode b -> random motors
void runModeB() {
  if (!isRunningB) return;

  // Check if 2 minutes have passed
  if (millis() - startTimeB >= runTime) {
    isRunningB = false;
    current1 = 0; current2 = 0; current3 = 0; 
    target1 = 0;  target2 = 0;  target3 = 0;
    resetServos();
    currentMode = ' '; // Return to idle state
    Serial.println("Mode B complete. Waiting for new command.");
    return;
  }
  
  unsigned long currentMillis = millis();

  //Pick new random target positions periodically
  if (currentMillis - lastRandomUpdate > randomDelay) {
    lastRandomUpdate = currentMillis;
  
    target1 = random(0, 111);
    target2 = random(0, 111);
    target3 = random(0, 111);
  
    // Wait time so servos have a chance to travel smoothly
    randomDelay = random(800, 1800); 
  }

  // 2. Incrementally move servos toward targets every 15ms
  if (currentMillis - lastStepTime > stepDelay) {
    lastStepTime = currentMillis;

    // Nudge servo 1 toward target
    if (current1 < target1) current1++;
    else if (current1 > target1) current1--;
  
    // Nudge servo 2 toward target
    if (current2 < target2) current2++;
    else if (current2 > target2) current2--;
  
    // Nudge servo 3 toward target
    if (current1 < target1) { // Typo fix: accurately updates current3 now
      if (current3 < target3) current3++;
      else if (current3 > target3) current3--;
    } else {
      if (current3 < target3) current3++;
      else if (current3 > target3) current3--;
    }

    // Write the smooth, tiny updates
    servo1.write(current1);
    servo2.write(current2);
    servo3.write(current3);
  }
}

// mode c --> amy's code
void runModeC() {
  if (digitalRead(buttonPin) == LOW && !isRunningC) {
    isRunningC = true;
    startTimeC = millis(); 
    Serial.println("Mode C started.");
  }

  if (isRunningC) {
    // Check if 2 minutes have passed
    if (millis() - startTimeC >= runTime) {
      isRunningC = false;
      resetServos();
      currentMode = ' '; // Return to idle
      Serial.println("Mode C complete. Waiting for new command.");
      return;
    }

    servo1.write(angleC);  
    servo2.write(angleC);
    servo3.write(angleC);
    delay(55);    

    angleC += incrementC;    

    if (angleC <= 0 || angleC >= 110) {
      incrementC = -incrementC;
    }
  }
}

// mode d -> co-design
void runModeD() {
  distance_cm = getDistance();

  if ((digitalRead(buttonPin) == LOW || (distance_cm > 0 && distance_cm <= 40)) && !isRunningD) {
    isRunningD = true;
    startTimeD = millis();
    delay(200); // Debounce
    Serial.println("Mode D started.");
  }

  if(!isRunningD) return; 

  if (isRunningD) {
    // Check if 2 minutes have passed
    if (millis() - startTimeD >= runTime) {
      isRunningD = false;
      resetServos();
      currentMode = ' '; // Return to idle
      Serial.println("Mode D complete. Waiting for new command.");
      return;
    }

    if (distance_cm > 0 && distance_cm <= 10) {
      playWavePatternD();      
      delay(25);
      angleD += incrementD;
    } 
    else if (distance_cm > 10 && distance_cm <= 20) {
      playWavePatternD();     
      delay(100);
      angleD += incrementD;
    } 
    else if (distance_cm > 20 && distance_cm <= 30) {
      playWavePatternD();    
      delay(150);
      angleD += incrementD;
    } 
    else {
      playWavePatternD();     
      delay(25);
      angleD += incrementD;
    } 

    if (angleD <= 0 || angleD >= 110) {
      incrementD = -incrementD;
    }
  }
}

// Wave pattern specific to Mode D
void playWavePatternD() {
  servo1.write(angleD);
  servo2.write(max(0, angleD - 15));
  servo3.write(max(0, angleD - 30));
}
